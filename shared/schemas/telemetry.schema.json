{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/telemetry.json",
  "title": "SensorTelemetry",
  "type": "object",
  "required": ["sensor_id", "cell_id", "metric", "value", "timestamp"],
  "properties": {
    "sensor_id": { "type": "string", "minLength": 3, "maxLength": 64 },
    "cell_id": { "type": "string", "minLength": 2, "maxLength": 64 },
    "metric": {
      "type": "string",
      "enum": ["water_level_cm", "pm25_ugm3", "temperature_c", "humidity_pct"]
    },
    "value": { "type": "number" },
    "unit": { "type": "string", "maxLength": 16 },
    "timestamp": {
      "oneOf": [
        { "type": "string", "format": "date-time" },
        { "type": "integer", "minimum": 0 }
      ]
    },
    "lat": { "type": "number", "minimum": -90, "maximum": 90 },
    "lon": { "type": "number", "minimum": -180, "maximum": 180 },
    "battery_pct": { "type": "number", "minimum": 0, "maximum": 100 }
  },
  "additionalProperties": false
}
