REDIS_URL=redis://redis:6379/0
REDIS_STREAM=telemetry:raw
ALERTS_STREAM=alerts:triggered
REDIS_CONSUMER_GROUP=anomaly-workers
REDIS_CONSUMER_NAME=worker-1

MQTT_BROKER_URL=mqtt://mosquitto:1883
MQTT_TOPIC=sensors/+/telemetry
MQTT_CLIENT_ID=telemetry-broker
MQTT_USERNAME=
MQTT_PASSWORD=

CUSUM_K=0.5
CUSUM_H=5.0
BASELINE_WINDOW=30
ALERT_COOLDOWN_SECONDS=300
MIN_SAMPLES_BEFORE_DETECT=15
ALERT_DISPATCH_COOLDOWN=45
OFFLINE_THRESHOLD_SECONDS=600

REQUIRE_ACK_FOR_CRITICAL=true
CRITICAL_ACK_TIMEOUT_SECONDS=300

ALERT_MODE=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
DEFAULT_ALERT_RECIPIENTS=+256700000000
WEBHOOK_ALERT_URL=

API_KEY=
BROKER_PORT=3000
LOG_LEVEL=info

POSTGRES_PASSWORD=earlywarn
DATABASE_URL=postgresql://earlywarn:earlywarn@postgres:5432/earlywarn

NEXT_PUBLIC_API_BASE=http://localhost:3000
SIMULATOR_INTERVAL_MS=2000
SIMULATOR_CELLS=cell-kampala-01,cell-kampala-02,cell-entebbe-01
CELLS_CONFIG_PATH=/app/config/cells.json
